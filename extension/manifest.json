{
  "manifest_version": 3,
  "name": "Stash",
  "version": "1.5",
  "description": "Your bookmark board on every new tab, and a button to file the current page into it.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8800/*",
    "https://*.papaly.com/*",
    "https://papaly.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Save to Stash (Ctrl+Shift+S)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Save the current page to Stash"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}